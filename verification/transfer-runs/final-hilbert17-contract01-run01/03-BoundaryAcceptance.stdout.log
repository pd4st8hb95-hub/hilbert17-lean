'Hilbert17Acceptance.candidate_fin0_explicit' depends on axioms: [propext, Classical.choice, Quot.sound]
'Hilbert17Acceptance.nonnegative_iff_rationalSOS' depends on axioms: [propext, Classical.choice, Quot.sound]
